# ─────────────────────────────────────────────────────────────────────────────
# RESTORA environment variables
#
# ON AZURE: add these in Static Web App → Settings → Environment variables.
# ON YOUR COMPUTER: copy this file to .env.local and fill it in (npm run local).
# NEVER commit real values to GitHub. .env.local is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED ────────────────────────────────────────────────────────────────────
# PostgreSQL connection (docs/DATABASE_SETUP.md, step 7)
DATABASE_URL=postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/restora

# Encrypts health records. Create with:  openssl rand -base64 32
# Keep a copy in a password manager. Never change it once records exist.
DATA_ENCRYPTION_KEY=

# Email address(es) that become administrators when they sign in (comma separated)
ADMIN_EMAILS=owner@example.com

# OPTIONAL: online payments (docs/AZURE_DEPLOYMENT.md, step 7) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# OPTIONAL: email confirmations, Azure Communication Services (step 8) ──────────
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER=

# OPTIONAL: text confirmations, Azure Communication Services (step 8) ───────────
ACS_SMS_CONNECTION_STRING=
ACS_SMS_FROM=

# OPTIONAL: Microsoft Entra External ID sign-in (Standard plan) ──────────────────
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=

# LOCAL ONLY ──────────────────────────────────────────────────────────────────
# Port for `npm run local` (default 4280)
LOCAL_PORT=4280
# For `npm test` when you can't run the embedded test database (e.g. as root):
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
