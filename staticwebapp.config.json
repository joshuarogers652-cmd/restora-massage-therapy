{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/x",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/api/admin/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/therapist/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/me",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/me/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/bookings",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout?post_logout_redirect_uri=/"
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/assets/*",
      "/images/*",
      "*.{css,js,mjs,map,json,webmanifest,svg,png,jpg,jpeg,gif,webp,ico,woff,woff2,ttf,txt,xml,pdf}"
    ]
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self' https://js.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; connect-src 'self' https://api.stripe.com; img-src 'self' data: https://*.stripe.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests",
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\")"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
