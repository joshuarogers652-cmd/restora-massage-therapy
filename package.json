{
  "name": "restora-massage-therapy",
  "version": "1.0.0",
  "private": true,
  "description": "RESTORA Massage Therapy — website, online booking and practice management (Azure Static Web Apps)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:api": "npm --prefix api run build",
    "install:api": "npm --prefix api ci",
    "local": "node scripts/local-server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:json": "node scripts/validate-json.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@stripe/react-stripe-js": "7.1.0",
    "@stripe/stripe-js": "10.3.0",
    "lucide-react": "1.76.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.0",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "10.4.21",
    "embedded-postgres": "17.5.0-beta.15",
    "pg": "8.23.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
